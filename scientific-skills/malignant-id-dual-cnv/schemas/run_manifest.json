{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "malignant-id-dual-cnv run manifest",
  "type": "object",
  "required": ["schema_version", "status", "started_at", "contract_sha256", "input_h5ad_sha256", "phases"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "status": { "enum": ["running", "awaiting_user_input", "failed", "passed_qc", "qc_failed"] },
    "started_at": { "type": "string" },
    "finished_at": { "type": ["string", "null"] },
    "contract_sha256": { "type": "string" },
    "input_h5ad_sha256": { "type": "string" },
    "environment_path": { "type": "string" },
    "phases": {
      "type": "object",
      "properties": {
        "phase00_pack": { "type": "string" },
        "phase01_scevan": { "type": "string" },
        "phase02_infercnv": { "type": "string" },
        "phase03_labels": { "type": "string" },
        "phase04_qc": { "type": "string" }
      }
    },
    "n_patients": { "type": "integer" },
    "n_target": { "type": "integer" },
    "n_tme": { "type": "integer" },
    "n_spike": { "type": "integer" },
    "n_hc": { "type": "integer" },
    "n_probable": { "type": "integer" },
    "n_cancer_cell": { "type": "integer" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
